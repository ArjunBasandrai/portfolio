---
interface Item {
  value: string;
  label: string;
  note?: string;
}
interface Props {
  items: Item[];
}
const { items } = Astro.props;
---

<div class="results">
  {items.map((r) => (
    <div class="r">
      <b>{r.value}</b>
      <span>{r.label}</span>
      {r.note && <small>{r.note}</small>}
    </div>
  ))}
</div>

<style>
  .results { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 16px; margin-top: 1.6em; }
  .results .r { border: 1px solid var(--line); border-radius: var(--radius); padding: 24px; }
  .results .r b { font-family: var(--font-serif); font-size: 2.2rem; display: block; line-height: 1; }
  .results .r span { font-family: var(--font-mono); font-size: 12px; color: var(--muted); display: block; margin-top: 10px; line-height: 1.4; }
  .results .r small { color: var(--st-active); font-family: var(--font-mono); font-size: 11px; display: block; margin-top: 6px; }
</style>
