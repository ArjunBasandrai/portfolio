---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const all = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
const featured = all.find((p) => p.data.featured) ?? all[0];
const rest = all;

const statusText = { active: "Active", progress: "In progress", done: "Completed", archived: "Archived" };
const statusClass = { active: "is-active", progress: "is-progress", done: "is-done", archived: "is-archive" };

const tagLabels: Record<string, string> = {
  ml: "Machine Learning",
  cv: "Computer Vision",
  research: "Research",
  systems: "Systems",
  data: "Data",
  fullstack: "Full Stack",
  birding: "Birding",
};
const usedTags = [...new Set(all.flatMap((p) => p.data.tags))].filter((t) => tagLabels[t]);
const filters = usedTags.sort((a, b) => Object.keys(tagLabels).indexOf(a) - Object.keys(tagLabels).indexOf(b));
---

<BaseLayout
  title="Projects · Arjun Basandrai"
  description="Machine learning, computer vision, and systems projects by Arjun Basandrai."
  current="projects"
>
  <main>
    <section class="page-head wrap">
      <span class="eyebrow">Selected work</span>
      <h1 style="margin:18px 0 14px;">Projects</h1>
      <p class="lead">A mix of research, models I trained to see how far I could push them, and things I built because the problem would not leave me alone. Each one has a write-up: the problem, the approach, and what actually happened.</p>
    </section>

    {featured && (
      <section class="wrap" style="padding-bottom:10px;">
        <a class="pfeat reveal" href={`/projects/${featured.id}`}>
          {featured.data.cover
            ? <img class="pfeat-cover" src={featured.data.cover} alt={featured.data.title} />
            : <div class="ph"><span>{featured.data.coverLabel}</span></div>}
          <div class="pfeat-body">
            <span class={`badge ${statusClass[featured.data.status]}`}><span class="dot"></span> {featured.data.statusLabel ?? statusText[featured.data.status]} · Featured</span>
            <h2>{featured.data.title}</h2>
            <p>{featured.data.summary}</p>
            {featured.data.stats.length > 0 && (
              <div class="pfeat-stats">
                {featured.data.stats.slice(0, 3).map((s) => (
                  <div class="s"><b>{s.value}</b><span>{s.label}</span></div>
                ))}
              </div>
            )}
            <div class="pfeat-links">
              <span class="btn btn--solid">Read case study <span class="arr">→</span></span>
              {featured.data.links.github && <span class="btn btn--ghost">GitHub ↗</span>}
            </div>
          </div>
        </a>
      </section>
    )}

    <section class="wrap">
      <div class="filter-bar" data-filter-bar>
        <span class="lbl">Category</span>
        <button data-tag="all" class="is-active">All</button>
        {filters.map((t) => <button data-tag={t}>{tagLabels[t]}</button>)}
      </div>

      <div class="proj-grid">
        {rest.map((p) => (
          <a class="card proj" href={`/projects/${p.id}`} data-tags={p.data.tags.join(",")}>
            {p.data.cover
              ? <img class="proj-cover" src={p.data.cover} alt={p.data.title} />
              : <div class="ph"><span>{p.data.coverLabel}</span></div>}
            <div class="proj-body">
              <div class="proj-top"><span class="cat">{p.data.category.join(" · ")}</span><span class={`badge ${statusClass[p.data.status]}`}><span class="dot"></span> {p.data.statusLabel ?? statusText[p.data.status]}</span></div>
              <h3>{p.data.title}</h3>
              <p>{p.data.summary}</p>
              <div class="proj-stack tag-row">{p.data.stack.slice(0, 3).map((s) => <span class="tag">{s}</span>)}</div>
            </div>
          </a>
        ))}
      </div>
      <p class="count-note"><span data-filter-count>{rest.length}</span> projects shown</p>
    </section>
  </main>
</BaseLayout>

<style>
  .page-head { padding-top: clamp(40px, 7vw, 88px); }
  .page-head h1 { font-family: var(--font-serif); font-size: clamp(2.6rem, 6vw, 4.4rem); letter-spacing: -0.02em; }

  .pfeat { display: grid; grid-template-columns: 1fr 1fr; gap: 0; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
  .pfeat .ph { border: 0; border-right: 1px solid var(--line); min-height: 360px; }
  .pfeat-cover { width: 100%; height: 100%; object-fit: cover; border-right: 1px solid var(--line); min-height: 360px; }
  .pfeat-body { padding: clamp(28px, 4vw, 52px); display: flex; flex-direction: column; }
  .pfeat-body h2 { font-family: var(--font-serif); font-size: clamp(1.9rem, 3.6vw, 2.9rem); letter-spacing: -0.015em; margin: 14px 0; }
  .pfeat-body p { color: var(--ink-soft); }
  .pfeat-stats { display: flex; gap: 36px; margin: 26px 0; flex-wrap: wrap; }
  .pfeat-stats .s b { font-family: var(--font-serif); font-size: 1.8rem; display: block; }
  .pfeat-stats .s span { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
  .pfeat-links { display: flex; gap: 12px; margin-top: auto; padding-top: 20px; }

  .filter-bar { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; padding: 22px 0; border-bottom: 1px solid var(--line); }
  .filter-bar .lbl { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); margin-right: 8px; }
  .filter-bar button { font-family: var(--font-mono); font-size: 12.5px; color: var(--muted); background: transparent; border: 1px solid var(--line); padding: 5px 13px; border-radius: 100px; cursor: pointer; transition: all .2s; }
  .filter-bar button:hover { color: var(--ink); border-color: var(--line-strong); }
  .filter-bar button.is-active { color: var(--accent-ink); border-color: var(--accent-line); background: var(--accent-soft); }

  .proj-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 22px; margin-top: 32px; }
  .proj { display: flex; flex-direction: column; padding: 0; overflow: hidden; }
  .proj .ph { aspect-ratio: 16/9; border: 0; border-bottom: 1px solid var(--line); }
  .proj .proj-cover { aspect-ratio: 16/9; width: 100%; object-fit: cover; border-bottom: 1px solid var(--line); }
  .proj-body { padding: 26px; display: flex; flex-direction: column; flex: 1; }
  .proj-top { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 14px; }
  .proj .cat { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent-ink); }
  .proj h3 { font-family: var(--font-serif); font-size: 1.5rem; letter-spacing: -0.01em; margin-bottom: 10px; }
  .proj p { color: var(--muted); font-size: 14.5px; flex: 1; }
  .proj-stack { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 18px; }
  .count-note { font-family: var(--font-mono); font-size: 12.5px; color: var(--muted); margin: 26px 0 0; }

  @media (max-width: 860px) {
    .pfeat { grid-template-columns: 1fr; }
    .pfeat .ph, .pfeat-cover { border-right: 0; border-bottom: 1px solid var(--line); min-height: 220px; }
    .proj-grid { grid-template-columns: 1fr; }
  }
</style>
